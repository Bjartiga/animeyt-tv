<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="https://animeyt.cc" version="1.0.0" viewmodes="maximized">
    <name>AnimeYT TV</name>
    <icon src="icon.png"/>
    <content src="index.html"/>

    <!-- Package ID debe ser de EXACTAMENTE 10 caracteres alfanuméricos -->
    <tizen:application id="aNiMeYT001.AnimeYTTV" package="aNiMeYT001" required_version="4.0"/>

    <tizen:profile name="tv-samsung"/>

    <!-- Bypass CORS completo -->
    <access origin="*" subdomains="true"></access>

    <!-- Privilegios Tizen TV y Red -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <!-- Metadata para Samsung Smart TV -->
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/html5.4k.support" value="true"/>

    <!-- Configuración de pantalla y eventos de control remoto -->
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
